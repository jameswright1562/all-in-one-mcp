{
  "name": "all-in-one-mcp",
  "version": "1.0.1",
  "description": "Managed MCP runtime with an HTTP admin API, gateway, and stdio proxy.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "bin": {
    "all-in-one-mcp": "./bin/all-in-one-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "cli",
    "runtime"
  ],
  "author": "James Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameswright1562/all-in-one-mcp.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/jameswright1562/all-in-one-mcp#readme",
  "bugs": {
    "url": "https://github.com/jameswright1562/all-in-one-mcp/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --force",
    "build:dashboard-bundle": "pnpm --filter @all-in-one-mcp/dashboard build && node ./scripts/copy-dashboard-bundle.mjs",
    "dev": "tsx watch src/cli.ts serve",
    "typecheck": "tsc -b --force",
    "lint": "eslint src test --ext .ts,.mts",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build && pnpm build:dashboard-bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
