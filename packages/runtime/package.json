{
  "name": "@all-in-one-mcp/runtime",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "all-in-one-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "pnpm --filter @all-in-one-mcp/contracts build && tsc --noEmit",
    "lint": "eslint src test --ext .ts,.mts",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@all-in-one-mcp/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
