{
  "name": "@all-in-one-mcp/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared schemas and type contracts for all-in-one-mcp.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "James Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameswright1562/all-in-one-mcp.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/jameswright1562/all-in-one-mcp#readme",
  "bugs": {
    "url": "https://github.com/jameswright1562/all-in-one-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
