{
  "name": "@all-in-one-mcp/contracts",
  "version": "1.0.0",
  "description": "Shared schemas and type contracts for all-in-one-mcp.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
