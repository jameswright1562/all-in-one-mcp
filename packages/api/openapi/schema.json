{
  "openapi": "3.0.0",
  "paths": {
    "/admin/health": {
      "get": {
        "operationId": "AdminController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminHealthDto"
                }
              }
            }
          }
        },
        "tags": ["Admin"]
      }
    },
    "/admin": {
      "get": {
        "operationId": "AdminController_getMcps",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedMcpCollectionDto"
                }
              }
            }
          }
        },
