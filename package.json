{
  "name": "all-in-one-mcp-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @all-in-one-mcp/dashboard dev",
    "mcp:serve": "pnpm --filter all-in-one-mcp build && node packages/runtime/dist/cli.js serve",
    "typecheck": "pnpm --filter all-in-one-mcp typecheck && pnpm --filter @all-in-one-mcp/dashboard typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm exec prettier --write .",
    "test:e2e": "pnpm --filter @all-in-one-mcp/dashboard test:e2e",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @all-in-one-mcp/dashboard build",
    "publish:packages": "pnpm --filter all-in-one-mcp publish --access public --no-git-checks",
    "sync:api": "pnpm --filter @all-in-one-mcp/api export:openapi && pnpm --filter @all-in-one-mcp/ui generate:api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.6.1",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.2.4"
  }
}
