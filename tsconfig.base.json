{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@all-in-one-mcp/contracts": ["./packages/contracts/src/index.ts"],
      "all-in-one-mcp": ["./packages/runtime/src/index.ts"]
    }
  }
}
