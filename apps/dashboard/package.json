{
  "name": "@all-in-one-mcp/dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm --filter @all-in-one-mcp/dashboard-shared build && nuxt build",
    "dev": "pnpm --filter all-in-one-mcp build && pnpm --filter @all-in-one-mcp/dashboard-shared build && nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "pnpm --filter all-in-one-mcp build && pnpm --filter @all-in-one-mcp/dashboard-shared build && nuxt typecheck",
    "lint": "eslint . --ext .ts,.vue",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@all-in-one-mcp/dashboard-shared": "workspace:*",
    "all-in-one-mcp": "workspace:*",
    "nuxt": "^4.4.2",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "all-in-one-mcp": "workspace:*"
  }
}
