{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All-in-One MCP Desktop",
  "version": "0.1.0",
  "identifier": "com.allinonemcp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter all-in-one-mcp build && pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm prepare-runtime",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "All-in-One MCP Desktop",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/**/*"]
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
