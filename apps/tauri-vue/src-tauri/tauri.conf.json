{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All-in-One MCP Desktop",
  "version": "0.1.0",
  "identifier": "com.allinonemcp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "All-in-One MCP Desktop",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/runtime-host/**"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "REPLACE_WITH_UPDATER_PUBKEY",
      "endpoints": [
        "https://example.com/all-in-one-mcp/{{target}}/{{current_version}}"
      ]
    }
  }
}
