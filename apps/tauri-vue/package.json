{
  "name": "@all-in-one-mcp/tauri-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "pnpm --filter @all-in-one-mcp/dashboard-shared build && vite",
    "build": "pnpm --filter all-in-one-mcp build && pnpm --filter @all-in-one-mcp/dashboard-shared build && vue-tsc --noEmit && vite build",
    "typecheck": "pnpm --filter @all-in-one-mcp/dashboard-shared build && vue-tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@all-in-one-mcp/dashboard-shared": "workspace:*",
    "@tauri-apps/api": "^2.5.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "all-in-one-mcp": "workspace:*",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^20.2.0",
    "vite": "^8.1.2",
    "vue-tsc": "^3.1.1"
  }
}
